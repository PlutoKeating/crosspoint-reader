# Source fonts used by convert-builtin-fonts.sh.
*
!.gitignore
!NotoSerif/
!NotoSerif/**
!NotoSans/
!NotoSans/**
!NotoSansArabic/
!NotoSansArabic/**
!NotoSansHebrew/
!NotoSansHebrew/**
!OpenDyslexic/
!OpenDyslexic/**
!Ubuntu/
!Ubuntu/**
